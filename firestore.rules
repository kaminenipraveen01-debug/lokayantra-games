rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == "yourgmail@gmail.com"
             && request.auth.token.email_verified == true;
    }

    match /games/{gameId} {
      // Anyone can read game listings
      allow read: if true;

      // Only admin can create, update, delete games.
      // Play-count increments go through the /api/games/[id]/play
      // route, which uses the Admin SDK and bypasses these rules.
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
